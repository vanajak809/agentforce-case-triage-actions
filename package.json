  "scripts": {
    "prettier": "prettier --write \"force-app/**/*.{cls,trigger,xml}\" \"{config,data}/**/*.json\" \"*.json\"",
    "prettier:verify": "prettier --check \"force-app/**/*.{cls,trigger,xml}\" \"{config,data}/**/*.json\" \"*.json\""
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-apex": "^2.3.0"
  }
}
